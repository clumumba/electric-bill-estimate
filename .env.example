# Local training only; keep production secrets in your deployment secret store.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=electricity-demand-forecast
APP_ENV=development
# Required for Compose / production; generate with secrets.token_urlsafe(32).
API_KEY=
# Alternatively set API_KEY_FILE to a mounted secret; it takes precedence.
